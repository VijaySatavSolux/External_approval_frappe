 "standard": 1,
 "template": "<div class=\"approval-container\" style=\"max-width: 800px; margin: 40px auto; padding: 20px; font-family: Arial, sans-serif;\">\n\t<h2 style=\"color: #333; border-bottom: 2px solid #007bff; padding-bottom: 10px;\">Document Approval</h2>\n\t\n\t<div class=\"document-info\" style=\"background: #f8f9fa; padding: 20px; border-radius: 5px; margin: 20px 0;\">\n\t\t<h3 style=\"color: #555;\">Document Information</h3>\n\t\t<p><strong>Document Type:</strong> {{ approval_info.doctype }}</p>\n\t\t<p><strong>Document Name:</strong> {{ approval_info.name }}</p>\n\t</div>\n\t\n\t<div class=\"document-details\" style=\"margin: 20px 0;\">\n\t\t<h3 style=\"color: #555;\">Document Details</h3>\n\t\t<div id=\"document-content\"></div>\n\t</div>\n\t\n\t<div class=\"approval-form\" style=\"background: #fff; padding: 20px; border: 1px solid #ddd; border-radius: 5px; margin: 20px 0;\">\n\t\t<h3 style=\"color: #555;\">Approval Form</h3>\n\t\t\n\t\t<div class=\"form-group\" style=\"margin: 15px 0;\">\n\t\t\t<label for=\"signature-name\" style=\"display: block; margin-bottom: 5px; font-weight: bold;\">Your Name <span style=\"color: red;\">*</span></label>\n\t\t\t<input type=\"text\" id=\"signature-name\" class=\"form-control\" style=\"width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;\" required>\n\t\t</div>\n\t\t\n\t\t<div class=\"form-group\" style=\"margin: 15px 0;\">\n\t\t\t<label for=\"signature-date\" style=\"display: block; margin-bottom: 5px; font-weight: bold;\">Date</label>\n\t\t\t<input type=\"date\" id=\"signature-date\" class=\"form-control\" style=\"width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;\">\n\t\t</div>\n\t\t\n\t\t<div class=\"form-group\" style=\"margin: 15px 0;\">\n\t\t\t<label for=\"comments\" style=\"display: block; margin-bottom: 5px; font-weight: bold;\">Comments (Optional)</label>\n\t\t\t<textarea id=\"comments\" class=\"form-control\" rows=\"4\" style=\"width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;\"></textarea>\n\t\t</div>\n\t\t\n\t\t<div class=\"form-actions\" style=\"margin-top: 20px;\">\n\t\t\t<button id=\"btn-approve\" class=\"btn btn-primary\" style=\"background-color: #28a745; color: white; padding: 10px 30px; border: none; border-radius: 5px; cursor: pointer; margin-right: 10px;\">Approve</button>\n\t\t\t<button id=\"btn-reject\" class=\"btn btn-danger\" style=\"background-color: #dc3545; color: white; padding: 10px 30px; border: none; border-radius: 5px; cursor: pointer;\">Reject</button>\n\t\t</div>\n\t</div>\n\t\n\t<div id=\"message\" style=\"margin: 20px 0; padding: 10px; border-radius: 5px; display: none;\"></div>\n</div>\n\n<script>\n\t// Set today's date as default\n\tdocument.getElementById('signature-date').valueAsDate = new Date();\n\t\n\t// Display document data\n\tconst documentData = {{ document_data | tojson }};\n\tconst documentContent = document.getElementById('document-content');\n\t\n\t// Create a simple table to display document fields\n\tlet html = '<table class=\"table\" style=\"width: 100%; border-collapse: collapse;\">';\n\tfor (let key in documentData) {\n\t\tif (key !== 'doctype' && key !== 'name' && typeof documentData[key] !== 'object') {\n\t\t\thtml += `<tr style=\"border-bottom: 1px solid #ddd;\"><td style=\"padding: 8px; font-weight: bold; width: 30%;\">${key.replace(/_/g, ' ').replace(/\\b\\w/g, l => l.toUpperCase())}:</td><td style=\"padding: 8px;\">${documentData[key] || '-'}</td></tr>`;\n\t\t}\n\t}\n\thtml += '</table>';\n\tdocumentContent.innerHTML = html;\n\t\n\t// Handle approval\n\tdocument.getElementById('btn-approve').addEventListener('click', function() {\n\t\tconst signatureName = document.getElementById('signature-name').value;\n\t\tconst signatureDate = document.getElementById('signature-date').value;\n\t\tconst comments = document.getElementById('comments').value;\n\t\t\n\t\tif (!signatureName) {\n\t\t\talert('Please enter your name');\n\t\t\treturn;\n\t\t}\n\t\t\n\t\tsubmitApproval('approve', signatureName, signatureDate, comments);\n\t});\n\t\n\t// Handle rejection\n\tdocument.getElementById('btn-reject').addEventListener('click', function() {\n\t\tconst comments = document.getElementById('comments').value;\n\t\tconst confirmReject = confirm('Are you sure you want to reject this document?');\n\t\tif (confirmReject) {\n\t\t\tsubmitApproval('reject', null, null, comments);\n\t\t}\n\t});\n\t\n\tfunction submitApproval(action, signatureName, signatureDate, comments) {\n\t\tconst token = new URLSearchParams(window.location.search).get('token');\n\t\tconst messageDiv = document.getElementById('message');\n\t\t\n\t\t// Disable buttons\n\t\tdocument.getElementById('btn-approve').disabled = true;\n\t\tdocument.getElementById('btn-reject').disabled = true;\n\t\t\n\t\tfrappe.call({\n\t\t\tmethod: 'external_approval_digital_sign.api.approval.submit_approval',\n\t\t\targs: {\n\t\t\t\ttoken: token,\n\t\t\t\taction: action,\n\t\t\t\tsignature_name: signatureName,\n\t\t\t\tsignature_date: signatureDate,\n\t\t\t\tcomments: comments\n\t\t\t},\n\t\t\tcallback: function(r) {\n\t\t\t\tif (r.message && r.message.status === 'success') {\n\t\t\t\t\tmessageDiv.style.display = 'block';\n\t\t\t\t\tmessageDiv.style.backgroundColor = '#d4edda';\n\t\t\t\t\tmessageDiv.style.color = '#155724';\n\t\t\t\t\tmessageDiv.style.border = '1px solid #c3e6cb';\n\t\t\t\t\tmessageDiv.innerHTML = `<strong>Success!</strong> ${r.message.message}`;\n\t\t\t\t\t\n\t\t\t\t// Hide form\n\t\t\t\tdocument.querySelector('.approval-form').style.display = 'none';\n\t\t\t} else {\n\t\t\t\tmessageDiv.style.display = 'block';\n\t\t\t\tmessageDiv.style.backgroundColor = '#f8d7da';\n\t\t\t\tmessageDiv.style.color = '#721c24';\n\t\t\t\tmessageDiv.style.border = '1px solid #f5c6cb';\n\t\t\t\tmessageDiv.innerHTML = `<strong>Error!</strong> ${r.message && r.message.message ? r.message.message : 'An error occurred'}`;\n\t\t\t\t\n\t\t\t\t// Re-enable buttons\n\t\t\t\tdocument.getElementById('btn-approve').disabled = false;\n\t\t\t\tdocument.getElementById('btn-reject').disabled = false;\n\t\t\t}\n\t\t}\n\t\t});\n\t}\n</script>"
}

